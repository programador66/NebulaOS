#!/usr/bin/env bash
# NebulaOS · nebula — sessões de agentes de IA (Claude Code / Codex) em tmux
set -euo pipefail

NEBULA_ROOT="${NEBULA_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
export NEBULA_ROOT
# shellcheck source=../scripts/lib.sh
source "$NEBULA_ROOT/scripts/lib.sh"

# ── utilitários ──────────────────────────────────────────────

# tmux respeitando o socket isolado dos testes
tm() {
  if [[ -n "${NEBULA_TMUX_SOCKET:-}" ]]; then
    tmux -L "$NEBULA_TMUX_SOCKET" "$@"
  else
    tmux "$@"
  fi
}

usage() {
  cat <<EOF
${C_BOLD}${C_GREEN}nebula${C_RESET} — sessões de agentes de IA no terminal

  nebula claude <nome> [dir] [--team N]   Claude como líder; sub-agentes em painéis
  nebula codex <nome> [dir]               Codex num painel (sub-agentes internos)
  nebula ls                               lista as sessões
  nebula attach <nome> [--team N|--sem-time]  volta para uma sessão
  nebula kill <nome>                      encerra uma sessão
  nebula rename <atual> <novo>            renomeia uma sessão
  nebula update                           atualiza o NebulaOS
  nebula help                             esta ajuda

  dir:       diretório do projeto (padrão: o atual)
  --team N:   pede ao Claude para já criar N sub-agentes (1 a 5)
  --sem-time: ao retomar depois de um reboot, não pede para recriar os sub-agentes
EOF
}

die_usage() { err "$1"; usage; exit 2; }

# só letras, números, '_' e '-': o resto vira '-' (o nome entra em comandos do tmux)
normalize_name() {
  local raw="$1" name
  name="$(printf '%s' "$raw" | LC_ALL=C sed -E 's/[^A-Za-z0-9_-]+/-/g')"
  if [[ ! "$name" =~ [A-Za-z0-9] ]]; then
    die_usage "nome de sessão inválido: '$raw' (use letras, números, '_' ou '-')"
  fi
  if [[ "$name" != "$raw" ]]; then
    warn "nome ajustado para '$name'" >&2
  fi
  printf '%s' "$name"
}

require_cmd() {
  local cmd="$1" hint="$2"
  if ! have "$cmd"; then
    err "$cmd não encontrado. $hint"
    exit 1
  fi
}

require_tmux() { require_cmd tmux "Instale com: sudo apt install tmux"; }

require_agent() {
  case "$1" in
    claude) require_cmd claude "Instale com: curl -fsSL https://claude.ai/install.sh | bash" ;;
    codex)  require_cmd codex  "Instale com: npm install -g @openai/codex" ;;
  esac
}

# ── abrir sessão ─────────────────────────────────────────────

TEAM_PROMPT='Crie um time de agentes com N sub-agentes (teammates) para esta sessão. Não comece nenhuma tarefa: apenas crie o time e aguarde minhas instruções.'

# linha de comando (sh) do painel líder
# leader_cmd AGENT TEAM [new|resume ID [PROMPT]]
# TEAM > 0 manda o pedido genérico de time; senão, PROMPT (se houver) vai como mensagem inicial
leader_cmd() {
  local agent="$1" team="$2" mode="${3:-}" id="${4:-}" prompt="${5:-}" cmd
  case "$agent" in
    claude)
      cmd="CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 claude --teammate-mode tmux"
      case "$mode" in
        new)    cmd+=" --session-id $id" ;;
        resume) cmd+=" --resume $id" ;;
      esac
      if ((team > 0)); then
        cmd+=" $(printf '%q' "${TEAM_PROMPT/N/$team}")"
      elif [[ -n "$prompt" ]]; then
        cmd+=" $(printf '%q' "$prompt")"
      fi
      ;;
    codex) cmd="codex" ;;
  esac
  printf '%s' "$cmd"
}

# Mantém o líder em cima e os sub-agentes lado a lado embaixo, só nesta sessão.
# O Claude Code aplica o próprio layout (main-vertical) depois de abrir sub-agentes,
# então o hook também reage a select-layout. Sem -t: vale a janela do próprio evento.
# (tmux não re-dispara hooks para comandos executados por um hook: sem recursão.)
LAYOUT_CMD="select-layout main-horizontal"

go_to_session() {
  local name="$1"
  if [[ -n "${TMUX:-}" ]]; then
    if [[ "${NEBULA_NO_ATTACH:-}" == 1 ]]; then echo "would-switch $name"; return; fi
    tm switch-client -t "=$name:"
  else
    if [[ "${NEBULA_NO_ATTACH:-}" == 1 ]]; then echo "would-attach $name"; return; fi
    tm attach-session -t "=$name:"
  fi
}

# ── estado (sobrevive ao reboot; o tmux não) ─────────────────
# ~/.local/state/nebula/<nome>: linhas agent=, dir=, claude_session=

state_dir() { printf '%s' "${XDG_STATE_HOME:-$HOME/.local/state}/nebula"; }
state_file() { printf '%s/%s' "$(state_dir)" "$1"; }
state_get() { [[ -f "$(state_file "$1")" ]] && sed -n "s/^$2=//p" "$(state_file "$1")" | head -1; }

state_save() {
  local name="$1" agent="$2" dir="$3" id="$4"
  mkdir -p "$(state_dir)"
  printf 'agent=%s\ndir=%s\nclaude_session=%s\n' "$agent" "$dir" "$id" > "$(state_file "$name")"
}

# ── sub-agentes anteriores (para recriar na retomada) ────────
# O Claude Code grava a conversa de cada sub-agente em ~/.claude/projects/<pasta>/*.jsonl
# com "teamName":"session-<8 primeiros do líder>" e "agentName":"<nome>". Formato interno:
# se mudar, nada é encontrado e o líder só é retomado.
previous_teammates() {
  local dir="$1" id="$2" proj team f
  proj="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(printf '%s' "$dir" | sed 's/[^A-Za-z0-9]/-/g')"
  team="session-${id:0:8}"
  [[ -d "$proj" ]] || return 0
  grep -lF "\"teamName\":\"$team\"" "$proj"/*.jsonl 2>/dev/null | while IFS= read -r f; do
    grep -oE '"agentName":"[^"]{1,40}"' "$f" | head -1 | sed -E 's/^"agentName":"(.*)"$/\1/'
  done | awk 'NF && !seen[$0]++'
}

# "A", "A e B", "A, B e C"
join_names() {
  local n=$# out="" i=0 x
  for x in "$@"; do
    i=$((i + 1))
    if ((i == 1)); then out="$x"
    elif ((i == n)); then out+=" e $x"
    else out+=", $x"
    fi
  done
  printf '%s' "$out"
}

restore_prompt() {
  printf 'Esta sessão foi retomada. Na sessão anterior você teve os sub-agentes %s. Recrie, com os mesmos nomes e papéis, apenas os que ainda estavam ativos no fim da sessão, e passe a cada um o contexto do que já foi feito e do que falta. Depois aguarde minhas instruções.' "$(join_names "$@")"
}

new_uuid() { cat /proc/sys/kernel/random/uuid; }

# cria a sessão tmux; retorna 1 se o agente morreu ao iniciar
start_session() {
  local agent="$1" name="$2" dir="$3" cmd="$4" t="=$2:"
  # tudo numa só chamada: se o agente morrer logo, não sobra sessão pela metade
  tm new-session -d -s "$name" -n "$name" -c "$dir" -e "PATH=$PATH" -e "NEBULA_SESSION=$name" \
      "$cmd" \; \
    set-option -t "$t" @nebula_agent "$agent" \; \
    set-option -t "$t" @nebula_dir "$dir" \; \
    set-option -F -t "$t" @nebula_leader '#{pane_id}' \; \
    set-option -t "$t" main-pane-height 55% \; \
    set-hook -t "$t" after-split-window "$LAYOUT_CMD" \; \
    set-hook -t "$t" after-select-layout "$LAYOUT_CMD" \; \
    select-pane -t "$t" -T "líder · $name" 2>/dev/null || true
  tm has-session -t "$t" 2>/dev/null
}

agent_died() {
  err "o agente encerrou ao iniciar. Rode '$1' direto em $2 para ver o erro."
  exit 1
}

cmd_open() {
  local agent="$1" name="$2" dir="$3" team="$4" old_dir id
  if tm has-session -t "=$name:" 2>/dev/null; then
    old_dir="$(tm show-options -t "=$name:" -v @nebula_dir 2>/dev/null || true)"
    if [[ -n "$old_dir" && "$old_dir" != "$dir" ]]; then
      warn "aviso: a sessão '$name' já existe em $old_dir; retomando (o diretório $dir foi ignorado)" >&2
    fi
  elif [[ "$agent" == claude && "$(state_get "$name" agent)" == claude \
          && -n "$(state_get "$name" claude_session)" ]]; then
    # sessão parada (reboot): retoma a conversa exata, na pasta original
    id="$(state_get "$name" claude_session)"
    old_dir="$(state_get "$name" dir)"
    [[ -d "$old_dir" ]] || old_dir="$dir"
    info "retomando a conversa anterior de '$name' em $old_dir"
    local prompt="" mates=()
    if ((team == 0)) && [[ "${NEBULA_SEM_TIME:-}" != 1 ]]; then
      mapfile -t mates < <(previous_teammates "$old_dir" "$id")
      if ((${#mates[@]})); then
        prompt="$(restore_prompt "${mates[@]}")"
        info "pedindo ao líder para recriar os sub-agentes ativos (anteriores: $(join_names "${mates[@]}"))"
      fi
    fi
    if ! start_session claude "$name" "$old_dir" "$(leader_cmd claude "$team" resume "$id" "$prompt")"; then
      warn "não encontrei a conversa anterior; começando uma nova" >&2
      id="$(new_uuid)"
      start_session claude "$name" "$old_dir" "$(leader_cmd claude "$team" new "$id")" \
        || agent_died claude "$old_dir"
      state_save "$name" claude "$old_dir" "$id"
    fi
  elif [[ "$agent" == claude ]]; then
    id="$(new_uuid)"
    start_session claude "$name" "$dir" "$(leader_cmd claude "$team" new "$id")" \
      || agent_died claude "$dir"
    state_save "$name" claude "$dir" "$id"
  else
    start_session "$agent" "$name" "$dir" "$(leader_cmd "$agent" "$team")" \
      || agent_died "$agent" "$dir"
  fi
  go_to_session "$name"
}

# nebula claude|codex <nome> [dir] [--team N]
parse_open() {
  local agent="$1"; shift
  local name="" dir="" team=0 have_team=0

  while (($#)); do
    case "$1" in
      --team)
        (($# >= 2)) || die_usage "--team precisa de um valor"
        have_team=1; team="$2"; shift 2 ;;
      --team=*)
        have_team=1; team="${1#--team=}"; shift ;;
      --sem-time)
        NEBULA_SEM_TIME=1; shift ;;
      -*)
        die_usage "opção desconhecida: $1" ;;
      *)
        if [[ -z "$name" ]]; then name="$1"
        elif [[ -z "$dir" ]]; then dir="$1"
        else die_usage "argumento a mais: $1"
        fi
        shift ;;
    esac
  done

  [[ -n "$name" ]] || die_usage "falta o nome da sessão"
  if ((have_team)) && [[ "${NEBULA_SEM_TIME:-}" == 1 ]]; then
    die_usage "use --team ou --sem-time, não os dois"
  fi
  if ((have_team)); then
    [[ "$agent" == claude ]] || die_usage "--team só vale para claude"
    [[ "$team" =~ ^[1-5]$ ]] || die_usage "--team aceita 1 a 5"
  fi

  require_tmux
  require_agent "$agent"

  dir="${dir:-$PWD}"
  if [[ ! -d "$dir" ]]; then
    err "diretório não existe: $dir"
    exit 1
  fi
  dir="$(cd "$dir" && pwd)"

  name="$(normalize_name "$name")"
  cmd_open "$agent" "$name" "$dir" "$team"
}

# ── ls / attach / kill / update ──────────────────────────────

require_session() {
  [[ -n "${1:-}" ]] || die_usage "falta o nome da sessão"
  require_tmux
  if ! tm has-session -t "=$1:" 2>/dev/null; then
    err "sessão '$1' não existe"
    exit 1
  fi
}

cmd_ls() {
  require_tmux
  local lines
  lines="$(tm list-sessions -F '#{session_name}	#{@nebula_agent}	#{@nebula_dir}' 2>/dev/null \
    | awk -F '\t' '$2 != ""' || true)"
  local f name
  if [[ -d "$(state_dir)" ]]; then
    for f in "$(state_dir)"/*; do
      [[ -f "$f" ]] || continue
      name="${f##*/}"
      tm has-session -t "=$name:" 2>/dev/null && continue
      lines+="${lines:+$'\n'}$name	$(state_get "$name" agent)	$(state_get "$name" dir)	parada (retomável)"
    done
  fi
  if [[ -z "$lines" ]]; then
    echo "nenhuma sessão nebula"
    return 0
  fi
  printf '%s\n' "$lines" | column -t -s $'\t'
}

cmd_attach() {
  local name="" team=0 have_team=0
  while (($#)); do
    case "$1" in
      --team)
        (($# >= 2)) || die_usage "--team precisa de um valor"
        have_team=1; team="$2"; shift 2 ;;
      --team=*) have_team=1; team="${1#--team=}"; shift ;;
      --sem-time) NEBULA_SEM_TIME=1; shift ;;
      -*) die_usage "opção desconhecida: $1" ;;
      *)
        [[ -z "$name" ]] || die_usage "argumento a mais: $1"
        name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die_usage "falta o nome da sessão"
  if ((have_team)); then
    [[ "${NEBULA_SEM_TIME:-}" != 1 ]] || die_usage "use --team ou --sem-time, não os dois"
    [[ "$team" =~ ^[1-5]$ ]] || die_usage "--team aceita 1 a 5"
  fi
  require_tmux
  if ! tm has-session -t "=$name:" 2>/dev/null && [[ "$(state_get "$name" agent)" == claude ]]; then
    require_agent claude
    cmd_open claude "$name" "$(state_get "$name" dir)" "$team"
    return
  fi
  require_session "$name"
  if ((have_team)); then
    warn "--team ignorado: a sessão '$name' já está aberta (peça os sub-agentes ao líder)" >&2
  fi
  go_to_session "$name"
}

cmd_kill() {
  [[ -n "${1:-}" ]] || die_usage "falta o nome da sessão"
  if [[ -f "$(state_file "$1")" ]] && ! tm has-session -t "=$1:" 2>/dev/null; then
    rm -f "$(state_file "$1")"
    ok "sessão parada '$1' removida"
    return
  fi
  require_session "$1"
  tm kill-session -t "=$1:"
  rm -f "$(state_file "$1")"
  ok "sessão '$1' encerrada"
}

cmd_rename() {
  (($# == 2)) || die_usage "uso: nebula rename <atual> <novo>"
  local old="$1" new leader
  require_session "$old"
  new="$(normalize_name "$2")"
  if tm has-session -t "=$new:" 2>/dev/null; then
    err "sessão '$new' já existe"
    exit 1
  fi
  leader="$(tm show-options -t "=$old:" -v @nebula_leader 2>/dev/null || true)"
  if [[ -z "$leader" ]]; then
    # sessões antigas, sem @nebula_leader: acha o líder pelo título
    leader="$(tm list-panes -s -t "=$old:" -F '#{pane_id} #{pane_title}' \
      | awk -v t="líder · $old" '{ id = $1; sub(/^[^ ]+ /, "") } $0 == t { print id; exit }')"
  fi
  tm rename-session -t "=$old:" "$new"
  if [[ -f "$(state_file "$old")" ]]; then
    mv "$(state_file "$old")" "$(state_file "$new")"
  fi
  tm set-environment -t "=$new:" NEBULA_SESSION "$new"
  if [[ -n "$leader" ]] && tm display-message -p -t "$leader" '' >/dev/null 2>&1; then
    tm select-pane -t "$leader" -T "líder · $new"
    if [[ "$(tm display-message -p -t "$leader" '#{window_name}')" == "$old" ]]; then
      tm rename-window -t "$leader" "$new"
    fi
  fi
  ok "sessão '$old' renomeada para '$new'"
}

cmd_update() { exec "$NEBULA_ROOT/update.sh"; }

main() {
  local sub="${1:-help}"
  (($#)) && shift
  case "$sub" in
    claude|codex) parse_open "$sub" "$@" ;;
    ls) cmd_ls ;;
    attach) cmd_attach "$@" ;;
    kill) cmd_kill "$@" ;;
    rename) cmd_rename "$@" ;;
    update) cmd_update ;;
    help|-h|--help) usage ;;
    *) die_usage "comando desconhecido: $sub" ;;
  esac
}

main "$@"
